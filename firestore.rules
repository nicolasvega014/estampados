rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // El catálogo y los pedidos se administran desde el panel del vendedor.
    // Nadie que no haya iniciado sesión puede leer ni modificar estos datos.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
